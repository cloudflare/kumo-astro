const sourceCode = `---
import Card from "@cloudflare/kumo-astro/components/card";
import CardHeader from "@cloudflare/kumo-astro/components/card-header";
import CardTitle from "@cloudflare/kumo-astro/components/card-title";
import CardDescription from "@cloudflare/kumo-astro/components/card-description";
import CardContent from "@cloudflare/kumo-astro/components/card-content";
import CardFooter from "@cloudflare/kumo-astro/components/card-footer";
import Input from "@cloudflare/kumo-astro/components/input";
import Button from "@cloudflare/kumo-astro/components/button";
import Label from "@cloudflare/kumo-astro/components/label";
import Field from "@cloudflare/kumo-astro/components/field";
import Link from "@cloudflare/kumo-astro/components/link";
import Separator from "@cloudflare/kumo-astro/components/separator";
import CloudflareLogo from "@cloudflare/kumo-astro/components/cloudflare-logo";
---

<div class="flex items-center justify-center bg-kumo-canvas min-h-screen p-8">
  <div class="w-full max-w-[360px]">

    <div class="mb-6 flex justify-center">
      <CloudflareLogo variant="glyph" height={48} />
    </div>

    <Card>
      <CardHeader class="space-y-1 pb-4">
        <CardTitle class="text-2xl">Sign in</CardTitle>
        <CardDescription class="text-sm text-pretty">
          Enter your email and password to access your account
        </CardDescription>
      </CardHeader>

      <CardContent class="space-y-3">
        <Field>
          <Label for="email">Email</Label>
          <Input id="email" type="email" placeholder="name@company.com" autocomplete="email" required />
        </Field>
        <p id="email-error" class="text-sm text-kumo-danger hidden">Please enter a valid email address</p>

        <Field>
          <div class="flex items-center justify-between">
            <Label for="password">Password</Label>
            <Link href="#" variant="inline" class="text-sm">Forgot password?</Link>
          </div>
          <Input id="password" type="password" placeholder="Enter your password" autocomplete="current-password" required minlength="8" />
        </Field>
        <p id="password-error" class="text-sm text-kumo-danger hidden">Password must be at least 8 characters</p>

        <div class="pt-2">
          <Button variant="primary" class="w-full justify-center" id="sign-in-btn">Sign In</Button>
        </div>

        <div class="relative py-4">
          <div class="absolute inset-0 flex items-center">
            <Separator class="w-full" />
          </div>
          <div class="relative flex justify-center text-xs uppercase">
            <span class="bg-kumo-base px-2 text-kumo-subtle">Or continue with</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <Button variant="secondary" class="w-full justify-center">Google</Button>
          <Button variant="secondary" class="w-full justify-center">GitHub</Button>
        </div>
      </CardContent>

      <CardFooter class="flex justify-center pt-4">
        <p class="text-sm text-kumo-subtle">
          Don't have an account? <Link href="#" variant="inline">Sign up</Link>
        </p>
      </CardFooter>
    </Card>
  </div>
</div>

<script>
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const signInBtn = document.getElementById('sign-in-btn');
  const emailError = document.getElementById('email-error');
  const passwordError = document.getElementById('password-error');

  function validateEmail() {
    const email = emailInput.value;
    const isValid = email.includes('@') && email.includes('.');
    if (email && !isValid) {
      emailError?.classList.remove('hidden');
      return false;
    }
    emailError?.classList.add('hidden');
    return true;
  }

  function validatePassword() {
    const password = passwordInput.value;
    if (password && password.length < 8) {
      passwordError?.classList.remove('hidden');
      return false;
    }
    passwordError?.classList.add('hidden');
    return true;
  }

  emailInput?.addEventListener('blur', validateEmail);
  passwordInput?.addEventListener('blur', validatePassword);

  signInBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const isEmailValid = validateEmail();
    const isPasswordValid = validatePassword();
    if (isEmailValid && isPasswordValid && emailInput.value && passwordInput.value) {
      alert('Form submitted! (This is a demo)');
    }
  });
</script>`;
