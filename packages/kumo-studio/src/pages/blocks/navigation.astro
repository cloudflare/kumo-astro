const sourceCode = `---
import Button from "@cloudflare/kumo-astro/components/button";
import Link from "@cloudflare/kumo-astro/components/link";
import CloudflareLogo from "@cloudflare/kumo-astro/components/cloudflare-logo";
---

<nav class="bg-kumo-base border-b border-kumo-hairline h-12 px-6 flex items-center justify-between">
  <div class="flex items-center gap-6">
    <CloudflareLogo variant="horizontal" height={20} />
    <div class="flex items-center gap-4">
      <a href="javascript:void(0)" class="text-sm text-kumo-subtle hover:text-kumo-default transition-colors">Products</a>
      <a href="javascript:void(0)" class="text-sm text-kumo-subtle hover:text-kumo-default transition-colors">Solutions</a>
      <a href="javascript:void(0)" class="text-sm text-kumo-subtle hover:text-kumo-default transition-colors">Docs</a>
      <a href="javascript:void(0)" class="text-sm text-kumo-subtle hover:text-kumo-default transition-colors">Pricing</a>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <Button variant="secondary" size="sm">Log in</Button>
    <Button variant="primary" size="sm">Sign up</Button>
  </div>
</nav>

<div class="bg-kumo-canvas p-8 text-center text-kumo-subtle text-sm">
  Page content goes here
</div>`;

