            <Card><CardContent class="p-6"><p class="text-xs text-kumo-subtle">Bounce Rate</p><p class="text-2xl font-bold text-kumo-default mt-1">42.3%</p><Badge variant="warning" class="mt-1.5">-2.4%</Badge></CardContent></Card>
          </div>
          <Card class="mb-6">
