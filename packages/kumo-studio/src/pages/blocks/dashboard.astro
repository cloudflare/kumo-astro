                  <TableRow><TableCell class="font-medium">Carol White</TableCell><TableCell>Deployed to production</TableCell><TableCell><Badge variant="success">Completed</Badge></TableCell><TableCell class="text-kumo-subtle">1 hour ago</TableCell></TableRow>
