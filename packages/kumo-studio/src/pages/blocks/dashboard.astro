const sourceCode = `---
import Card from "@cloudflare/kumo-astro/components/card";
import CardHeader from "@cloudflare/kumo-astro/components/card-header";
import CardTitle from "@cloudflare/kumo-astro/components/card-title";
import CardContent from "@cloudflare/kumo-astro/components/card-content";
import CardDescription from "@cloudflare/kumo-astro/components/card-description";
import Button from "@cloudflare/kumo-astro/components/button";
import Badge from "@cloudflare/kumo-astro/components/badge";
import Table from "@cloudflare/kumo-astro/components/table";
import TableHeader from "@cloudflare/kumo-astro/components/table-header";
import TableBody from "@cloudflare/kumo-astro/components/table-body";
import TableRow from "@cloudflare/kumo-astro/components/table-row";
import TableHead from "@cloudflare/kumo-astro/components/table-head";
import TableCell from "@cloudflare/kumo-astro/components/table-cell";
import { DashboardChart } from "../components/DashboardChart"; // React island
---

<div class="flex h-screen bg-kumo-canvas">

  <!-- Sidebar -->
  <aside class="w-56 border-r border-kumo-hairline bg-kumo-base flex flex-col shrink-0">
    <div class="p-4 border-b border-kumo-hairline">
      <p class="text-sm font-semibold text-kumo-default">My App</p>
      <p class="text-xs text-kumo-subtle">Admin Panel</p>
    </div>
    <nav class="flex-1 p-3 space-y-0.5">
      <a href="#" class="flex items-center gap-2.5 px-3 py-2 rounded-lg bg-kumo-elevated text-kumo-default text-sm font-medium">Overview</a>
      <a href="#" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-kumo-subtle hover:bg-kumo-elevated hover:text-kumo-default transition-colors text-sm">Users</a>
      <a href="#" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-kumo-subtle hover:bg-kumo-elevated hover:text-kumo-default transition-colors text-sm">Analytics</a>
      <a href="#" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-kumo-subtle hover:bg-kumo-elevated hover:text-kumo-default transition-colors text-sm">Settings</a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 overflow-auto p-6">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-kumo-default">Overview</h1>
        <p class="text-sm text-kumo-subtle mt-0.5">Welcome back! Here's what's happening today.</p>
      </div>
      <Button variant="primary">Download Report</Button>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
      <Card>
        <CardContent class="p-6">
          <p class="text-xs text-kumo-subtle">Total Revenue</p>
          <p class="text-2xl font-bold text-kumo-default mt-1">$48k</p>
          <Badge variant="success" class="mt-1.5">+12.5%</Badge>
        </CardContent>
      </Card>
      <Card>
        <CardContent class="p-6">
          <p class="text-xs text-kumo-subtle">Active Users</p>
          <p class="text-2xl font-bold text-kumo-default mt-1">2,431</p>
          <Badge variant="success" class="mt-1.5">+8.2%</Badge>
        </CardContent>
      </Card>
      <Card>
        <CardContent class="p-6">
          <p class="text-xs text-kumo-subtle">New Signups</p>
          <p class="text-2xl font-bold text-kumo-default mt-1">384</p>
          <Badge variant="info" class="mt-1.5">+3.1%</Badge>
        </CardContent>
      </Card>
      <Card>
        <CardContent class="p-6">
          <p class="text-xs text-kumo-subtle">Bounce Rate</p>
          <p class="text-2xl font-bold text-kumo-default mt-1">42.3%</p>
          <Badge variant="warning" class="mt-1.5">-2.4%</Badge>
        </CardContent>
      </Card>
    </div>

    <!-- Chart -->
    <Card class="mb-6">
      <CardHeader>
        <CardTitle>Traffic Overview</CardTitle>
        <CardDescription>Request and error metrics over the past hour</CardDescription>
      </CardHeader>
      <CardContent>
        <DashboardChart client:only="react" />
      </CardContent>
    </Card>

    <!-- Activity Table -->
    <Card>
      <CardHeader>
        <CardTitle>Recent Activity</CardTitle>
        <CardDescription>Latest actions across your application</CardDescription>
      </CardHeader>
      <CardContent>
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>User</TableHead>
              <TableHead>Action</TableHead>
              <TableHead>Status</TableHead>
              <TableHead>Date</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            <TableRow>
              <TableCell class="font-medium">Alice Johnson</TableCell>
              <TableCell>Created new project</TableCell>
              <TableCell><Badge variant="success">Completed</Badge></TableCell>
              <TableCell class="text-kumo-subtle">2 minutes ago</TableCell>
            </TableRow>
            <TableRow>
              <TableCell class="font-medium">Bob Smith</TableCell>
              <TableCell>Updated DNS records</TableCell>
              <TableCell><Badge variant="info">In Progress</Badge></TableCell>
              <TableCell class="text-kumo-subtle">15 minutes ago</TableCell>
            </TableRow>
            <TableRow>
              <TableCell class="font-medium">Carol White</TableCell>
              <TableCell>Deployed to production</TableCell>
              <TableCell><Badge variant="success">Completed</Badge></TableCell>
              <TableCell class="text-kumo-subtle">1 hour ago</TableCell>
            </TableRow>
            <TableRow>
              <TableCell class="font-medium">David Brown</TableCell>
              <TableCell>Failed login attempt</TableCell>
              <TableCell><Badge variant="warning">Failed</Badge></TableCell>
              <TableCell class="text-kumo-subtle">3 hours ago</TableCell>
            </TableRow>
          </TableBody>
        </Table>
      </CardContent>
    </Card>
  </main>
</div>`;
---

<DocLayout
  title="Dashboard"
  description="An admin dashboard with a sidebar navigation, stat cards, a timeseries chart, and a recent activity table."
>

  {/* Hero */}

  <ComponentSection>
    <div class="not-prose overflow-hidden rounded-lg">
    <div class="rounded-t-lg border border-kumo-hairline bg-kumo-canvas">
      <div class="flex h-[800px]">
        <aside class="w-56 border-r border-kumo-hairline bg-kumo-base flex flex-col shrink-0">
          <div class="p-4 border-b border-kumo-hairline">
            <p class="text-sm font-semibold text-kumo-default">My App</p>
            <p class="text-xs text-kumo-subtle">Admin Panel</p>
          </div>
          <nav class="flex-1 p-3 space-y-0.5">
            <a href="#" class="flex items-center gap-2.5 px-3 py-2 rounded-lg bg-kumo-elevated text-kumo-default text-sm font-medium">Overview</a>
