---
interface Props {
  title: string;
  href?: string;
}

const { title, href } = Astro.props;
---

<div class="flex flex-col min-h-80 border-r border-b border-gray-200">
  <div class="px-4 pt-3.5">
    <span class="text-[13px] text-gray-500 font-normal">{title}</span>
  </div>
  <div class="flex flex-1 items-center justify-center px-4 py-6">
    <slot />
  </div>
</div>
