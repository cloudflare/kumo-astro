---
import Layout from "../layouts/Layout.astro";
import BlockCard from "../components/BlockCard.astro";

const blocks = [
  { title: "Auth", slug: "auth" },
  { title: "Dashboard", slug: "dashboard" },
  { title: "Forms", slug: "forms" },
  { title: "Hero", slug: "hero" },
  { title: "Marketing", slug: "marketing" },
  { title: "Navigation", slug: "navigation" },
  { title: "Pricing", slug: "pricing" },
  { title: "Settings", slug: "settings" },
];
---

<Layout pageTitle="Kumo Blocks">
  <div class="grid grid-cols-3 border-kumo-line xl:grid-cols-3 md:grid-cols-2 sm:grid-cols-1">
    {blocks.map((block) => (
      <BlockCard title={block.title} href={`/blocks/${block.slug}`}>
        <div class="flex items-center justify-center w-full min-h-[200px] text-[13px] text-kumo-subtle border border-dashed border-kumo-line rounded-md">
          <span>{block.title}</span>
        </div>
      </BlockCard>
    ))}
  </div>
</Layout>
