---
import { cn } from "../utils/cn";
interface Props { class?: string; [key: string]: unknown; }
const { class: className, ...rest } = Astro.props;
---
<button
  type="button"
  data-kumo-dropdown-trigger
  aria-expanded="false"
  aria-haspopup="menu"
  class={className}
  {...rest}
>
  <slot />
</button>
