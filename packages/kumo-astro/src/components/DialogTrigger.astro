---
/**
 * DialogTrigger — button that opens the dialog.
 *
 * Must be a sibling of `<Dialog>` inside `<DialogRoot>`.
 */
import { cn } from "../utils/cn";

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<button
  type="button"
  data-kumo-dialog-trigger
  aria-expanded="false"
  aria-haspopup="dialog"
  class={className}
  {...rest}
>
  <slot />
</button>
