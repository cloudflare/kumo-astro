---
/**
 * Toggle — a two-state button that can be toggled on or off.
 *
 * Usage:
 * ```astro
 * <Toggle aria-label="Bold">B</Toggle>
 * <Toggle pressed={true} size="sm">Bold</Toggle>
 * <Toggle variant="outline">Italic</Toggle>
 * ```
 */
import { cn } from "../utils/cn";
import {
  KUMO_TOGGLE_VARIANTS,
  type KumoToggleVariant,
  type KumoToggleSize,
  KUMO_TOGGLE_DEFAULT_VARIANTS,
} from "@cloudflare/kumo/components/toggle";

interface Props {
  /**
   * Whether the toggle is initially pressed/active.
   * @default false
   */
  pressed?: boolean;
  /**
   * Visual variant.
   * - `"default"` — Base background style
   * - `"outline"` — Transparent with ring
   * @default "default"
   */
  variant?: KumoToggleVariant;
  /**
   * Size of the toggle.
   * - `"sm"` — Small
   * - `"base"` — Default
   * - `"lg"` — Large
   * @default "base"
   */
  size?: KumoToggleSize;
  /** Accessible label (required for icon-only toggles). */
  "aria-label"?: string;
  disabled?: boolean;
  /** Additional CSS classes merged via cn(). */
  class?: string;
  [key: string]: unknown;
}

const {
  pressed = false,
  variant = KUMO_TOGGLE_DEFAULT_VARIANTS.variant,
  size = KUMO_TOGGLE_DEFAULT_VARIANTS.size,
  disabled,
  class: className,
  ...rest
} = Astro.props;

const variantConfig =
  KUMO_TOGGLE_VARIANTS.variant[variant as KumoToggleVariant] ??
  KUMO_TOGGLE_VARIANTS.variant[KUMO_TOGGLE_DEFAULT_VARIANTS.variant];

const sizeConfig =
  KUMO_TOGGLE_VARIANTS.size[size as KumoToggleSize] ??
  KUMO_TOGGLE_VARIANTS.size[KUMO_TOGGLE_DEFAULT_VARIANTS.size];
---

<button
  type="button"
  role="button"
  aria-pressed={pressed}
  data-state={pressed ? "on" : "off"}
  data-kumo-toggle
  disabled={disabled || undefined}
  class={cn(
    "inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg font-medium select-none",
    "transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-kumo-brand",
    "disabled:cursor-not-allowed disabled:opacity-50",
    variantConfig.classes,
    sizeConfig.classes,
    className,
  )}
  {...rest}
>
  <slot />
</button>

<script>
  function initToggle(button: HTMLElement) {
    if (button.dataset.kumoToggleInit) return;
    button.dataset.kumoToggleInit = "1";

    button.addEventListener("click", () => {
      const isPressed = button.getAttribute("aria-pressed") === "true";
      const newPressed = !isPressed;
      button.setAttribute("aria-pressed", String(newPressed));
      button.dataset.state = newPressed ? "on" : "off";
    });
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>("[data-kumo-toggle]")
      .forEach(initToggle);
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
