---
/**
 * Primary action trigger. Supports multiple variants, sizes, shapes, icons, and loading state.
 *
 * Usage:
 * ```astro
 * <Button variant="primary">Save</Button>
 * <Button variant="secondary" shape="square" aria-label="Add">
 *   <!-- icon SVG here -->
 * </Button>
 * ```
 *
 * **Note:** Tooltip wrapping (via `title` prop) is deferred to Phase 4.
 * The `title` prop is accepted but the tooltip is not rendered until then.
 *
 * **Dev-mode warning:** Icon-only buttons (`shape="square"` or `shape="circle"`)
 * require `aria-label` for accessibility. A runtime console warning is emitted
 * in dev mode when it is missing.
 */
import { cn } from "../utils/cn";
import {
  buttonVariants,
  KUMO_BUTTON_DEFAULT_VARIANTS,
  type KumoButtonVariant,
  type KumoButtonSize,
  type KumoButtonShape,
} from "@cloudflare/kumo/components/button";

interface Props {
  /**
   * Visual style of the button.
   * @default "secondary"
   */
  variant?: KumoButtonVariant;
  /**
   * Button size.
   * @default "base"
   */
  size?: KumoButtonSize;
  /**
   * Button shape.
   * @default "base"
   */
  shape?: KumoButtonShape;
  /** Shows a loading spinner and disables interaction. */
  loading?: boolean;
  /**
   * When set, wraps the button in a Tooltip — deferred to Phase 4. Currently ignored.
   */
  title?: string;
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  class?: string;
  /** Required for shape="square" or shape="circle" buttons. */
  "aria-label"?: string;
  [key: string]: unknown;
}

const {
  variant = KUMO_BUTTON_DEFAULT_VARIANTS.variant,
  size = KUMO_BUTTON_DEFAULT_VARIANTS.size,
  shape = KUMO_BUTTON_DEFAULT_VARIANTS.shape,
  loading = false,
  disabled = false,
  type = "button",
  class: className,
  title: _title,
  ...rest
} = Astro.props;
---

<button
  class={cn(
    buttonVariants({ variant, size, shape }),
    (disabled || loading) && "cursor-not-allowed opacity-50",
    className,
  )}
  disabled={loading || disabled}
  type={type}
  {...rest}
>
  {loading && (
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      stroke="currentColor"
      style="height:14px;width:14px"
      role="status"
      aria-label="Loading"
    >
      <circle cx="12" cy="12" r="9.5" fill="none" stroke-width="2" stroke-linecap="round">
        <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="2s" repeatCount="indefinite" />
        <animate attributeName="stroke-dasharray" values="0 150;42 150;42 150" keyTimes="0;0.5;1" dur="1.5s" repeatCount="indefinite" />
        <animate attributeName="stroke-dashoffset" values="0;-16;-59" keyTimes="0;0.5;1" dur="1.5s" repeatCount="indefinite" />
      </circle>
      <circle cx="12" cy="12" r="9.5" fill="none" opacity="0.1" stroke-width="2" stroke-linecap="round" />
    </svg>
  )}
  <span class="contents">
    <slot />
  </span>
</button>
