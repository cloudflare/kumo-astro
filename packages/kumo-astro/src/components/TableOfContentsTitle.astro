---
import { cn } from "../utils/cn";

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<p
  class={cn(
    "mb-3 text-xs font-semibold tracking-wide text-kumo-subtle uppercase",
    className,
  )}
  {...rest}
>
  <slot />
</p>
