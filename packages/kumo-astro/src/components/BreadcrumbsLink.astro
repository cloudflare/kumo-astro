---
import { cn } from "../utils/cn";

interface Props {
  href: string;
  class?: string;
  [key: string]: unknown;
}

const { href, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  class={cn(
    "flex min-w-0 max-w-full items-center gap-1 text-kumo-subtle no-underline",
    className,
  )}
  {...rest}
>
  <slot name="icon" />
  <span class="truncate"><slot /></span>
</a>
