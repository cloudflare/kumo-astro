---
import { cn } from "../utils/cn";
interface Props { class?: string; [key: string]: unknown; }
const { class: className, ...rest } = Astro.props;
---
<div
  data-kumo-popover-content
  hidden
  style="position:absolute;z-index:50"
  class={cn(
    "flex flex-col rounded-lg bg-kumo-base px-4 py-3 text-sm text-kumo-default",
    "shadow-lg outline outline-kumo-fill",
    "transition-[transform,opacity] duration-150",
    "data-[open]:opacity-100 data-[open]:scale-100",
    "data-[closed]:opacity-0 data-[closed]:scale-90",
    className,
  )}
  {...rest}
>
  <slot />
</div>
