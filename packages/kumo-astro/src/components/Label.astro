---
/**
 * Label component for form fields.
 *
 * Usage:
 * ```astro
 * <Label>Email</Label>
 * <Label showOptional>Middle Name</Label>
 * <Label for="email-input">Email</Label>
 * <Label tooltip="We'll use this to contact you">Email</Label>
 * ```
 */
import { cn } from "../utils/cn";
import Button from "./Button.astro";
import Tooltip from "./Tooltip.astro";

interface Props {
  /** When true, shows gray "(optional)" text after the label. */
  showOptional?: boolean;
  /** The id of the form element this label is associated with. Use `for` (HTML attr). */
  for?: string;
  /** Tooltip content displayed next to the label via an info icon. */
  tooltip?: string;
  /**
   * When true, only renders the inline content without the outer label element.
   * @default false
   */
  asContent?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  showOptional = false,
  for: htmlFor,
  tooltip,
  asContent = false,
  class: className,
  ...rest
} = Astro.props;

const labelClasses = cn(
  "m-0 text-base font-medium text-kumo-default",
  "inline-flex items-center gap-1",
  className,
);

const contentClasses = cn("inline-flex items-center gap-1", className);
---

{asContent ? (
  <span class={contentClasses} {...rest}>
    <slot />
    {showOptional && (
      <span class="font-normal text-kumo-subtle">(optional)</span>
    )}
    {tooltip && (
      <Tooltip content={tooltip}>
        <Button variant="ghost" size="xs" shape="square" aria-label="More information">
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM124,72a12,12,0,1,1-12,12A12,12,0,0,1,124,72Z"/>
          </svg>
        </Button>
      </Tooltip>
    )}
  </span>
) : (
  <label for={htmlFor} class={labelClasses} {...rest}>
    <slot />
    {showOptional && (
      <span class="font-normal text-kumo-subtle">(optional)</span>
    )}
    {tooltip && (
      <Tooltip content={tooltip}>
        <Button variant="ghost" size="xs" shape="square" aria-label="More information">
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM124,72a12,12,0,1,1-12,12A12,12,0,0,1,124,72Z"/>
          </svg>
        </Button>
      </Tooltip>
    )}
  </label>
)}
