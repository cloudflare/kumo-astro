---
/**
 * CardContent — main content area of a Card.
 *
 * Usage:
 * ```astro
 * <CardContent>
 *   <p>Your content here.</p>
 * </CardContent>
 * ```
 */
import { cn } from "../utils/cn";

interface Props {
  /** Additional CSS classes merged via cn(). */
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<div class={cn("px-6 pb-6 pt-0", className)} {...rest}>
  <slot />
</div>
