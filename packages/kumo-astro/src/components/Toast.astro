---
/**
 * Toast — fixed-position notification container with imperative JS API.
 *
 * Renders a fixed container that receives programmatically created toasts.
 * After including this component once in a page layout, call `window.kumoToast()`
 * from anywhere on the page to show notifications.
 *
 * Usage:
 * ```astro
 * <!-- In your layout or page (once per page) -->
 * <Toast position="bottom-right" />
 * ```
 *
 * ```js
 * // Anywhere in your page scripts or onclick handlers
 * kumoToast({ title: "Saved", description: "Changes saved successfully.", variant: "success" });
 * kumoToast({ title: "Error", variant: "error", duration: 6000 });
 * kumoToast({ description: "Quick note.", variant: "default" });
 * ```
 */
import { cn } from "../utils/cn";

type ToastPosition =
  | "top-right"
  | "bottom-right"
  | "top-left"
  | "bottom-left"
  | "top-center"
  | "bottom-center";

interface Props {
  /**
   * Where the toast container is anchored on the screen.
   * @default "bottom-right"
   */
  position?: ToastPosition;
  class?: string;
  [key: string]: unknown;
}

const { position = "bottom-right", class: className, ...rest } = Astro.props;

const positionClasses: Record<ToastPosition, string> = {
  "top-right": "top-4 right-4 items-end",
  "bottom-right": "bottom-4 right-4 items-end",
  "top-left": "top-4 left-4 items-start",
  "bottom-left": "bottom-4 left-4 items-start",
  "top-center": "top-4 left-1/2 -translate-x-1/2 items-center",
  "bottom-center": "bottom-4 left-1/2 -translate-x-1/2 items-center",
};
---

<div
  data-kumo-toast-container
  data-position={position}
  role="region"
  aria-live="polite"
  aria-atomic="false"
  aria-label="Notifications"
  class={cn(
    "fixed z-[100] flex flex-col gap-2 p-4",
    positionClasses[position],
    className,
  )}
  {...rest}
>
  {/* Toasts are injected here dynamically by kumoToast() */}
</div>

<script>
  type KumoToastVariant = "default" | "success" | "error" | "warning" | "info";

  interface KumoToastOptions {
    title?: string;
    description?: string;
    variant?: KumoToastVariant;
    /** Auto-dismiss duration in ms. @default 4000 */
    duration?: number;
  }

  function createToastEl(opts: KumoToastOptions): HTMLElement {
    const el = document.createElement("div");
    el.setAttribute("role", "status");
    el.setAttribute("data-kumo-toast", "");

    const variantClasses: Record<KumoToastVariant, string> = {
      default: "bg-kumo-base ring-kumo-line",
      success: "bg-kumo-base ring-kumo-success",
      error: "bg-kumo-base ring-kumo-danger",
      warning: "bg-kumo-base ring-kumo-warning",
      info: "bg-kumo-base ring-kumo-info",
    };

    const variantClass = variantClasses[opts.variant ?? "default"];

    el.className = [
      "flex items-start gap-3 rounded-lg px-4 py-3 shadow-lg ring min-w-64 max-w-sm",
      "transition-all duration-200 opacity-0 translate-y-2",
      variantClass,
    ].join(" ");

    // Icon SVG paths (Phosphor icons, 256×256 viewBox)
    const iconPaths: Partial<Record<KumoToastVariant, string>> = {
      success:
        '<svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" class="mt-0.5 shrink-0 text-kumo-success"><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"/></svg>',
      error:
        '<svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" class="mt-0.5 shrink-0 text-kumo-danger"><path d="M236.8,188.09,149.35,36.22a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM120,104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm8,88a12,12,0,1,1,12-12A12,12,0,0,1,128,192Z"/></svg>',
      warning:
        '<svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" class="mt-0.5 shrink-0 text-kumo-warning"><path d="M236.8,188.09,149.35,36.22a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM120,104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm8,88a12,12,0,1,1,12-12A12,12,0,0,1,128,192Z"/></svg>',
      info: '<svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" class="mt-0.5 shrink-0 text-kumo-info"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"/></svg>',
    };

    const iconHtml = iconPaths[opts.variant ?? "default"] ?? "";

    // Close button SVG (X icon)
    const closeSvg =
      '<svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/></svg>';

    el.innerHTML = [
      iconHtml,
      '<div class="flex-1 min-w-0">',
      opts.title
        ? `<p class="text-sm font-medium text-kumo-default">${escapeHtml(opts.title)}</p>`
        : "",
      opts.description
        ? `<p class="text-sm text-kumo-subtle">${escapeHtml(opts.description)}</p>`
        : "",
      "</div>",
      `<button type="button" data-kumo-toast-close aria-label="Dismiss notification" class="shrink-0 text-kumo-subtle hover:text-kumo-default transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-kumo-brand rounded">${closeSvg}</button>`,
    ].join("");

    return el;
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function kumoToast(opts: KumoToastOptions = {}) {
    const container = document.querySelector<HTMLElement>("[data-kumo-toast-container]");
    if (!container) {
      if (typeof console !== "undefined") {
        console.warn(
          "[kumo] kumoToast() called but no <Toast> container found on the page. " +
          "Add <Toast /> to your layout.",
        );
      }
      return;
    }

    const el = createToastEl(opts);
    container.appendChild(el);

    // Animate in on next frame
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.classList.remove("opacity-0", "translate-y-2");
      });
    });

    function dismiss() {
      el.classList.add("opacity-0", "translate-y-2");
      setTimeout(() => el.remove(), 200);
    }

    el.querySelector("[data-kumo-toast-close]")?.addEventListener("click", dismiss);

    const duration = opts.duration ?? 4000;
    if (duration > 0) {
      setTimeout(dismiss, duration);
    }
  }

  // Expose globally so inline onclick="kumoToast(...)" and external scripts work
  (window as any).kumoToast = kumoToast;
</script>
