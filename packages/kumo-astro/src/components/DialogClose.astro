---
/**
 * DialogClose — button that closes the dialog.
 *
 * Must be inside `<Dialog>`. The DialogRoot script listens for clicks
 * on `[data-kumo-dialog-close]` and calls closeDialog().
 */
import { cn } from "../utils/cn";

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<button
  type="button"
  data-kumo-dialog-close
  class={className}
  {...rest}
>
  <slot />
</button>
