---
import { cn } from "../utils/cn";

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<div
  class={cn("flex min-w-0 max-w-full items-center gap-1 font-medium", className)}
  aria-current="page"
  {...rest}
>
  <slot name="icon" />
  <span class="truncate"><slot /></span>
</div>
