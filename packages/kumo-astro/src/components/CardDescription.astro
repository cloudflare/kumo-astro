---
/**
 * CardDescription — supporting description text inside a CardHeader.
 *
 * Usage:
 * ```astro
 * <CardDescription>Supporting text for the card.</CardDescription>
 * ```
 */
import { cn } from "../utils/cn";

interface Props {
  /** Additional CSS classes merged via cn(). */
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<p class={cn("text-sm text-kumo-subtle", className)} {...rest}>
  <slot />
</p>
