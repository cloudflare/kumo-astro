{
  "name": "kumo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "engines": {
    "node": "^24.12.0",
    "pnpm": ">=10.21.0"
  },
  "scripts": {
    "build": "pnpm --filter @cloudflare/kumo-docs-astro build",
    "codegen": "pnpm --filter @cloudflare/kumo-docs-astro codegen:demos && pnpm --filter @cloudflare/kumo codegen",
    "build:all": "pnpm -r build",
    "changeset": "tsx ci/scripts/ensure-changeset-config.ts && changeset",
    "clean": "pnpm -r exec rm -rf dist build .astro .wrangler node_modules",
    "dev": "pnpm codegen && pnpm --filter @cloudflare/kumo-docs-astro dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "lint": "pnpm --filter @cloudflare/kumo lint && oxlint --config .oxlintrc.json packages/*/src",
    "lockfile-check": "pnpm install --no-frozen-lockfile && git diff --exit-code pnpm-lock.yaml",
    "preview": "pnpm --filter @cloudflare/kumo-docs-astro preview",
    "publish:beta": "echo 'ERROR: Publishing is disabled in this fork. See DOCS/PUBLISH.md.' && exit 1",
    "deploy:kumo-docs-preview": "bash ci/versioning/deploy-kumo-docs-preview.sh",
    "deploy:kumo-docs-staging": "bash ci/versioning/deploy-kumo-docs-staging.sh",
    "deploy:kumo-docs-astro-preview": "bash ci/versioning/deploy-kumo-docs-astro-preview.sh",
    "deploy:kumo-docs-astro-staging": "bash ci/versioning/deploy-kumo-docs-astro-staging.sh",
    "ci:post-pr-report": "tsx ci/scripts/post-pr-report.ts",
    "release": "echo 'ERROR: Publishing is disabled in this fork. See DOCS/PUBLISH.md.' && exit 1",
    "release:beta": "echo 'ERROR: Publishing is disabled in this fork. See DOCS/PUBLISH.md.' && exit 1",
    "release:production": "echo 'ERROR: Publishing is disabled in this fork. See DOCS/PUBLISH.md.' && exit 1",
    "kumo": "node packages/kumo/dist/command-line/cli.js",
    "test": "pnpm --filter @cloudflare/kumo test",
    "test:watch": "pnpm --filter @cloudflare/kumo test:watch",
    "test:astro": "pnpm --filter @cloudflare/kumo-astro test",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version",
    "version:beta": "./ci/versioning/version-beta.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "workerd"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@octokit/rest": "22.0.1",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "lefthook": "2.0.12",
    "oxlint": "catalog:",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
